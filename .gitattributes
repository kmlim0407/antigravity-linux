# ============================================================
# Git Attributes
# WSL + Windows 혼용 환경에서 줄바꿈 충돌 방지
# ============================================================

# 기본값: 텍스트 파일은 LF로 통일 (WSL/Linux 기준)
* text=auto eol=lf

# ============================================================
# Web Source
# ============================================================
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.env   text eol=lf

# ============================================================
# Config
# ============================================================
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.config.*      text eol=lf
*.mjs           text eol=lf

# ============================================================
# Binary — 줄바꿈 변환 금지
# ============================================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   text eol=lf
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.pdf   binary
*.zip   binary
